{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "**/src/**/*",
      "**/vite.config.ts",
      "!**/src/routeTree.gen.ts",
      "!**/src/styles.css",
      "!**/src/paraglide"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space"
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "plugins": [
    {
      "path": "./biome-plugins/no-dynamic-message-access.grit",
      "includes": ["src/**", "!src/paraglide/**"]
    }
  ],
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "security": {
        "noDangerouslySetInnerHtml": "off"
      },
      "suspicious": {
        "noArrayIndexKey": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
