    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.7",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.75.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "takumi-js": "^2.20.0",
    "tw-animate-css": "^1.4.0"
